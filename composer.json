{
  "name": "itinerisltd/sage-lib",
  "license": "MIT",
  "description": "Library files for Sage 9 Starter Theme, maintained by Itineris to support legacy sites",
  "homepage": "https://github.com/ItinerisLtd/sage-9-lib",
  "authors": [
    {
      "name": "QWp6t",
      "email": "hi@qwp6t.me",
      "homepage": "https://github.com/qwp6t"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    },
    {
      "name": "codepuncher",
      "email": "lee.hanbury@gmail.com",
      "homepage": "https://github.com/codepuncher"
    },
    {
      "name": "Itineris Limited",
      "homepage": "https://github.com/ItinerisLtd"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "support": {
    "issues": "https://github.com/ItinerisLtd/sage-9-lib/issues",
    "forum": "https://discourse.roots.io/"
  },
  "autoload": {
    "psr-4": {
      "Roots\\Sage\\": ""
    }
  },
  "require": {
    "php": ">=8.4",
    "composer/installers": "^2.0",
    "illuminate/view": "^12.0",
    "illuminate/config": "^12.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7"
  },
  "conflict": {
    "symfony/clock": ">=8.1,<8.2",
    "symfony/translation": ">=8.1,<8.2"
  },
  "scripts": {
    "test": [
      "phpcs --ignore=vendor --extensions=php --standard=PSR2 ."
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
